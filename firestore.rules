rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && !exists(/databases/$(database)/documents/account_deletions/$(request.auth.uid)); }
    function master() { return signedIn() && request.auth.uid == 'pmyu29TlC3QM7JIysmy2EmiHSWW2'; }
    function admin() { return signedIn() && request.auth.uid in ['smnnQd4RhEQZR3uuNN0otNALUqi1', 'pmyu29TlC3QM7JIysmy2EmiHSWW2', 'PAtM8Lv1TBNLSiQzBLJK9Oda8KK2', 'hwZEme8xvkasSAGrmOtQRLOnnXn1', 'PKDpb7Cb7ig8ZKZRMm23FOKnCHQ2', 'Tgj9KT6C21XjeistBWRiSVYqTDC2', 'DSMERv7Uu4b4eEYQx5SKbjvdher2']; }
    function limited() { return request.auth.uid in ['POSB6W7xeDZ8Dlba03ZP3J02dMC3', 'AX08qKp7lte6vslQMFn76FVqxw53', 'KYqiqNKTmkQQYVWAa6bp6vSvTlV2']; }
    function configured() { return exists(/databases/$(database)/documents/user_access/$(request.auth.uid)); }
    function legacy(area) {
      return area == 'baustellen' ? (limited() ? 'none' : 'edit') :
        area == 'archiv' || area == 'logs' ? (admin() ? 'edit' : 'none') :
        area == 'kabelreport' ? (admin() ? 'edit' : 'view') : 'edit';
    }
    function level(area) {
      return configured() ? get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.get('permissions', {}).get(area, 'none') : legacy(area);
    }
    function canRead(area) { return signedIn() && (master() || level(area) in ['view', 'edit']); }
    function canWrite(area) { return signedIn() && (master() || level(area) == 'edit'); }
    function manageTemplates() { return signedIn() && (master() || (configured() ? (get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.get('permissions', {}).get('materialvorlagen', admin() && canWrite('baustellen') ? 'edit' : 'none') == 'edit') : (admin() && canWrite('baustellen')))); }
    function manageFinished() { return canWrite('baustellen') && (master() || (configured() ? get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.get('permissions', {}).get('beendete', admin() ? 'edit' : 'none') == 'edit' : admin())); }
    function materialWritable(id) { let site = get(/databases/$(database)/documents/baustellen/$(id)).data; return (site.status == 'aktiv' && canWrite('baustellen')) || (site.status in ['rausschreiben','beendet'] && manageFinished()) || (site.status == 'archiviert' && manager('archiv')); }
    function manager(area) { return canWrite(area) && (master() || configured() || admin()); }
    function validLevel(value) { return value in ['none', 'view', 'edit']; }
    function validAccess() {
      let p = request.resource.data.permissions;
      return p is map && p.keys().hasOnly(['kabellager','baustellen','archiv','kabelreport','logs','spiel','gespart','materialvorlagen','beendete']) &&
        p.keys().hasAll(['kabellager','baustellen','archiv','kabelreport','logs','spiel']) &&
        validLevel(p.kabellager) && validLevel(p.baustellen) && validLevel(p.archiv) &&
        validLevel(p.kabelreport) && validLevel(p.logs) && validLevel(p.spiel) && validLevel(p.get('gespart', 'none')) && p.get('materialvorlagen', 'none') in ['none', 'edit'] && p.get('beendete', 'none') in ['none','edit'] &&
        request.resource.data.keys().hasOnly(['permissions','updatedAt','updatedBy']) &&
        request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
    }
    function validOwnProfile() {
      return request.resource.data.get('username', '') is string && request.resource.data.get('username', '').size() <= 120 &&
        request.resource.data.get('email', '') == request.auth.token.get('email', '') &&
        (!('lastSeenAt' in request.resource.data) || request.resource.data.lastSeenAt == request.time ||
          (resource != null && request.resource.data.lastSeenAt == resource.data.get('lastSeenAt', null)));
    }
    // Server-only deletion markers block still-valid ID tokens. No client writes.
    match /account_deletions/{userId} {
      allow read, write: if false;
    }
    match /user_access/{userId} {
      allow get: if master() || (signedIn() && request.auth.uid == userId);
      allow list: if master();
      allow create, update: if master() && userId != request.auth.uid && !exists(/databases/$(database)/documents/account_deletions/$(userId)) && validAccess();
      allow delete: if master() && userId != request.auth.uid;
    }
    match /users/{userId} {
      allow read: if master() || (signedIn() && request.auth.uid == userId);
      allow create: if (master() && !exists(/databases/$(database)/documents/account_deletions/$(userId))) || (signedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['username','email','updatedAt','lastSeenAt']) && validOwnProfile());
      allow update: if (master() && !exists(/databases/$(database)/documents/account_deletions/$(userId))) || (signedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username','email','updatedAt','lastSeenAt']) && validOwnProfile());
      allow delete: if master() && userId != request.auth.uid;
    }
    // Only the current user may read their own push preference; all existing rules stay unchanged.
    match /push_preferences/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, write: if false;
    }
    match /bobinen/{document} {
      allow read: if canRead('kabellager');
      allow create, update, delete: if canWrite('kabellager');
    }
    // Baustellen and archive share documents. Page rights grant access to this shared data.
    match /baustellen/{document} {
      allow read: if canRead('baustellen') || canRead('archiv');
      allow create: if canWrite('baustellen') && request.resource.data.status == 'aktiv';
      allow update: if (canWrite('baustellen') && resource.data.status == 'aktiv' && request.resource.data.status in ['aktiv','rausschreiben']) || (resource.data.status in ['beendet','rausschreiben'] && manageFinished()) || (resource.data.status == 'archiviert' && manager('archiv')); 
      allow delete: if (canWrite('baustellen') && resource.data.status == 'aktiv') ||
        (manageFinished() && resource.data.status in ['beendet','rausschreiben']) || (manager('archiv') && resource.data.status == 'archiviert');
    }
    match /baustellen_material/{document} {
      allow read: if canRead('baustellen') || canRead('archiv');
      allow create: if materialWritable(request.resource.data.baustelleId);
      allow update: if materialWritable(resource.data.baustelleId) && request.resource.data.baustelleId == resource.data.baustelleId;
      allow delete: if materialWritable(resource.data.baustelleId);
    }
    match /material_vorlagen/{document} {
      allow read: if canRead('baustellen') || canRead('archiv') || manageTemplates();
      allow create, update, delete: if manageTemplates();
    }
    // Cable reports are calculated from logs; report readers can read that source data.
    match /logs/{document} {
      allow read: if canRead('logs') || canRead('kabelreport');
      allow create: if canWrite('kabellager') || canWrite('baustellen') || canWrite('archiv') || manageTemplates();
      allow update: if false;
      allow delete: if manager('logs');
    }
    match /kabel_report_snapshots/{document} {
      allow read: if canRead('kabelreport');
      allow create, update, delete: if manager('kabelreport');
    }
    match /gespart_tarife/{document} {
      allow read: if canRead('gespart');
      allow create, update, delete: if canWrite('gespart');
    }
    match /gespart_monatsreports/{document} {
      allow read: if canRead('gespart');
      allow create, update, delete: if canWrite('gespart');
    }
    match /strommastRanking/{document} {
      allow read: if canRead('spiel');
      allow create: if canWrite('spiel');
      allow update, delete: if manager('spiel');
    }
  }
}

