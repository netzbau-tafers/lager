rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && !exists(/databases/$(database)/documents/account_deletions/$(request.auth.uid)); }
    function master() { return signedIn() && request.auth.uid == 'pmyu29TlC3QM7JIysmy2EmiHSWW2'; }
    function admin() { return signedIn() && request.auth.uid in ['smnnQd4RhEQZR3uuNN0otNALUqi1', 'pmyu29TlC3QM7JIysmy2EmiHSWW2', 'PAtM8Lv1TBNLSiQzBLJK9Oda8KK2', 'hwZEme8xvkasSAGrmOtQRLOnnXn1', 'PKDpb7Cb7ig8ZKZRMm23FOKnCHQ2', 'Tgj9KT6C21XjeistBWRiSVYqTDC2', 'DSMERv7Uu4b4eEYQx5SKbjvdher2']; }
    function limited() { return request.auth.uid in ['POSB6W7xeDZ8Dlba03ZP3J02dMC3', 'AX08qKp7lte6vslQMFn76FVqxw53', 'KYqiqNKTmkQQYVWAa6bp6vSvTlV2']; }
    function configured() { return exists(/databases/$(database)/documents/user_access/$(request.auth.uid)); }
    function userAdminRead() { return signedIn() && (master() || (configured() && level('benutzer') in ['view','edit'])); }
    function userAdminWrite() { return signedIn() && (master() || (configured() && level('benutzer') == 'edit')); }
    function protectedMaster(userId) { return userId == 'pmyu29TlC3QM7JIysmy2EmiHSWW2'; }
    // Protect explicit administrator titles and legacy admin titles inferred from permissions.
    // Read both states to prevent downgrade and upgrade in one transaction.
    function legacyNamedAdmin(userId) { return userId in ['smnnQd4RhEQZR3uuNN0otNALUqi1', 'pmyu29TlC3QM7JIysmy2EmiHSWW2', 'PAtM8Lv1TBNLSiQzBLJK9Oda8KK2', 'hwZEme8xvkasSAGrmOtQRLOnnXn1', 'PKDpb7Cb7ig8ZKZRMm23FOKnCHQ2', 'Tgj9KT6C21XjeistBWRiSVYqTDC2', 'DSMERv7Uu4b4eEYQx5SKbjvdher2']; }
    function legacyLimitedUser(userId) { return userId in ['POSB6W7xeDZ8Dlba03ZP3J02dMC3', 'AX08qKp7lte6vslQMFn76FVqxw53', 'KYqiqNKTmkQQYVWAa6bp6vSvTlV2']; }
    function isAdministratorTitle(userId, profile, permissions) {
      let title = profile.get('adminTitle', '');
      let oldAdmin = legacyNamedAdmin(userId);
      let site = permissions.get('baustellen', legacyLimitedUser(userId) ? 'none' : 'edit');
      return title == 'administrator' || (
        !(title in ['administrator','baustellenverantwortlicher','mitarbeiter','techniker','leseberechtigter','hauptadministrator']) &&
        permissions.get('kabellager', 'edit') == 'edit' && site == 'edit' &&
        permissions.get('archiv', oldAdmin ? 'edit' : 'none') == 'edit' &&
        permissions.get('materialvorlagen', oldAdmin ? 'edit' : 'none') == 'edit' &&
        permissions.get('beendete', oldAdmin ? 'edit' : 'none') == 'edit'
      );
    }
    function adminAccountBefore(userId) {
      let p=/databases/$(database)/documents/users/$(userId);
      let a=/databases/$(database)/documents/user_access/$(userId);
      return isAdministratorTitle(userId, exists(p) ? get(p).data : {}, exists(a) ? get(a).data.get('permissions',{}) : {});
    }
    function adminAccountAfter(userId) {
      let p=/databases/$(database)/documents/users/$(userId);
      let a=/databases/$(database)/documents/user_access/$(userId);
      return isAdministratorTitle(userId, existsAfter(p) ? getAfter(p).data : {}, existsAfter(a) ? getAfter(a).data.get('permissions',{}) : {});
    }
    function mayManageAccount(userId) {
      return master() || (!protectedMaster(userId) && !adminAccountBefore(userId) && !adminAccountAfter(userId));
    }
    function legacy(area) {
      return area == 'stangenlager' ? 'none' : area == 'baustellen' ? (limited() ? 'none' : 'edit') :
        area == 'archiv' || area == 'logs' ? (admin() ? 'edit' : 'none') :
        area == 'kabelreport' ? (admin() ? 'edit' : 'view') : 'edit';
    }
    function level(area) {
      return configured() ? get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.get('permissions', {}).get(area, 'none') : legacy(area);
    }
    function canRead(area) { return signedIn() && (master() || level(area) in ['view', 'edit']); }
    function canWrite(area) { return signedIn() && (master() || level(area) == 'edit'); }
    function manageTemplates() { return signedIn() && (master() || (configured() ? (get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.get('permissions', {}).get('materialvorlagen', admin() && canWrite('baustellen') ? 'edit' : 'none') == 'edit') : (admin() && canWrite('baustellen')))); }
    function manageFinished() { return canWrite('baustellen') && (master() || (configured() ? get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.get('permissions', {}).get('beendete', admin() ? 'edit' : 'none') == 'edit' : admin())); }
    function materialWritable(id) { let site = get(/databases/$(database)/documents/baustellen/$(id)).data; return (site.status == 'aktiv' && canWrite('baustellen')) || (site.status in ['rausschreiben','beendet'] && manageFinished()) || (site.status == 'archiviert' && manager('archiv')); }
    function manager(area) { return canWrite(area) && (master() || configured() || admin()); }
    function validLevel(value) { return value in ['none', 'view', 'edit']; }
    function validAccess() {
      let p = request.resource.data.permissions;
      return p is map && p.keys().hasOnly(['benutzer','kabellager','stangenlager','baustellen','archiv','kabelreport','logs','spiel','gespart','materialvorlagen','materialScannen','beendete','fahrtenbuch','fahrtenbuchExport','fahrzeuge','fahrzeugeErstellen','fahrzeugeUebernehmen']) &&
        p.keys().hasAll(['kabellager','baustellen','archiv','kabelreport','logs','spiel']) &&
        validLevel(p.get('benutzer','none')) && validLevel(p.kabellager) && validLevel(p.get('stangenlager','none')) && validLevel(p.baustellen) && validLevel(p.archiv) &&
        validLevel(p.kabelreport) && validLevel(p.logs) && validLevel(p.spiel) && validLevel(p.get('gespart', 'none')) && p.get('materialScannen', 'none') in ['none','edit'] && p.get('materialvorlagen', 'none') in ['none', 'edit'] && p.get('beendete', 'none') in ['none','edit'] && p.get('fahrtenbuch', 'none') in ['none','edit'] && p.get('fahrtenbuchExport', 'none') in ['none','edit'] && validLevel(p.get('fahrzeuge', 'none')) && p.get('fahrzeugeErstellen', 'none') in ['none','edit'] && p.get('fahrzeugeUebernehmen', 'none') in ['none','edit'] &&
        request.resource.data.keys().hasOnly(['permissions','updatedAt','updatedBy']) &&
        request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
    }
    function validOwnProfile() {
      return request.resource.data.get('username', '') is string && request.resource.data.get('username', '').size() <= 120 &&
        request.resource.data.get('email', '') == request.auth.token.get('email', '') &&
        (!('lastSeenAt' in request.resource.data) || request.resource.data.lastSeenAt == request.time ||
          (resource != null && request.resource.data.lastSeenAt == resource.data.get('lastSeenAt', null)));
    }
    // Server-only deletion markers block still-valid ID tokens. No client writes.
    match /account_deletions/{userId} {
      allow read, write: if false;
    }
    match /user_access/{userId} {
      allow get: if userAdminRead() || (signedIn() && request.auth.uid == userId);
      allow list: if userAdminRead();
      allow create, update: if userAdminWrite() && mayManageAccount(userId) && userId != request.auth.uid && !exists(/databases/$(database)/documents/account_deletions/$(userId)) && validAccess();
      allow delete: if userAdminWrite() && mayManageAccount(userId) && userId != request.auth.uid;
    }
    match /users/{userId} {
      allow read: if userAdminRead() || (signedIn() && request.auth.uid == userId);
      allow create: if (userAdminWrite() && mayManageAccount(userId) && !exists(/databases/$(database)/documents/account_deletions/$(userId))) || (signedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['email','updatedAt','lastSeenAt']) && validOwnProfile());
      allow update: if (userAdminWrite() && mayManageAccount(userId) && !exists(/databases/$(database)/documents/account_deletions/$(userId))) || (signedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','updatedAt','lastSeenAt']) && validOwnProfile());
      allow delete: if userAdminWrite() && mayManageAccount(userId) && userId != request.auth.uid;
    }
    // Users read their own status; the master can list statuses for user administration.
    match /push_preferences/{userId} {
      allow get: if userAdminRead() || (signedIn() && request.auth.uid == userId);
      allow list: if userAdminRead();
      allow write: if false;
    }
    // Vehicle rights are opt-in; no legacy fallback. Status/history writes are server-only.
    function readVehicles() { return signedIn() && (master() || (configured() && get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.get('permissions', {}).get('fahrzeuge', 'none') in ['view','edit'])); }
    match /fahrzeug_nachtraege/{requestId} {
      allow read: if readVehicles() && resource.data.targetUid == request.auth.uid;
      allow write: if false;
    }
    match /fahrzeuge/{vehicleId} {
      allow read: if readVehicles();
      allow write: if false;
      match /verlauf/{eventId} {
        allow read: if readVehicles();
        allow write: if false;
      }
    }
    match /fahrzeug_favoriten/{userId}/fahrzeuge/{vehicleId} {
      allow read: if readVehicles() && request.auth.uid == userId;
      allow create, update: if readVehicles() && request.auth.uid == userId &&
        exists(/databases/$(database)/documents/fahrzeuge/$(vehicleId)) &&
        request.resource.data.keys().hasOnly(['updatedAt']) && request.resource.data.updatedAt == request.time;
      allow delete: if readVehicles() && request.auth.uid == userId;
    }
    // Nur lesbare Jahreskennzahlen; Änderungen erfolgen ausschliesslich serverseitig.
    match /dashboard_stats/{year} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /bobinen/{document} {
      allow read: if canRead('kabellager');
      allow create, update, delete: if canWrite('kabellager');
    }
    function validStock() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','infos','image','createdAt','updatedAt','reservation']) &&
        d.keys().hasAll(['name','infos','image','createdAt','updatedAt','reservation']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 120 &&
        d.infos is string && d.infos.size() <= 2000 &&
        d.image is string && d.image.size() <= 240000 &&
        d.image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$') &&
        d.createdAt is timestamp && d.updatedAt == request.time &&
        (d.reservation == null || (d.reservation is map &&
          d.reservation.keys().hasOnly(['site','person','uid','date']) &&
          d.reservation.keys().hasAll(['site','person','uid','date']) &&
          d.reservation.site is string && d.reservation.site.size() > 0 && d.reservation.site.size() <= 180 &&
          d.reservation.person is string && d.reservation.person.size() > 0 && d.reservation.person.size() <= 120 &&
          d.reservation.uid is string && d.reservation.date is timestamp));
    }
    match /stangenlager/{document} {
      allow read: if canRead('stangenlager');
      allow create: if canWrite('stangenlager') && validStock() &&
        request.resource.data.createdAt == request.time && request.resource.data.reservation == null;
      allow update: if canWrite('stangenlager') && validStock() &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (request.resource.data.reservation == resource.data.reservation ||
          request.resource.data.reservation == null ||
          (resource.data.reservation == null &&
            request.resource.data.reservation.uid == request.auth.uid &&
            request.resource.data.reservation.date == request.time));
      allow delete: if canWrite('stangenlager');
    }
    // Baustellen and archive share documents. Page rights grant access to this shared data.
    match /baustellen/{document} {
      allow read: if canRead('baustellen') || canRead('archiv');
      allow create: if canWrite('baustellen') && request.resource.data.status == 'aktiv';
      allow update: if (canWrite('baustellen') && resource.data.status == 'aktiv' && request.resource.data.status in ['aktiv','rausschreiben']) || (resource.data.status in ['beendet','rausschreiben'] && manageFinished()) || (resource.data.status == 'archiviert' && manager('archiv')); 
      allow delete: if (canWrite('baustellen') && resource.data.status == 'aktiv') ||
        (manageFinished() && resource.data.status in ['beendet','rausschreiben']) || (manager('archiv') && resource.data.status == 'archiviert');
    }
    match /baustellen_material/{document} {
      allow read: if canRead('baustellen') || canRead('archiv');
      allow create: if materialWritable(request.resource.data.baustelleId);
      allow update: if materialWritable(resource.data.baustelleId) && request.resource.data.baustelleId == resource.data.baustelleId;
      allow delete: if materialWritable(resource.data.baustelleId);
    }
    match /material_vorlagen/{document} {
      allow read: if canRead('baustellen') || canRead('archiv') || manageTemplates();
      allow create, update, delete: if manageTemplates();
    }
    // Cable reports are calculated from logs; report readers can read that source data.
    match /logs/{document} {
      allow read: if canRead('logs') || canRead('kabelreport');
      allow create: if (request.resource.data.get('bereich','') == 'Stangenlager' ?
        (canWrite('stangenlager') && request.resource.data.benutzerUid == request.auth.uid && request.resource.data.createdAt == request.time) :
        (canWrite('kabellager') || canWrite('baustellen') || canWrite('archiv') || manageTemplates()));
      allow update: if false;
      allow delete: if master();
    }
    match /kabel_report_snapshots/{document} {
      allow read: if canRead('kabelreport');
      allow create, update, delete: if manager('kabelreport');
    }
    match /gespart_tarife/{document} {
      allow read: if canRead('gespart');
      allow create, update, delete: if canWrite('gespart');
    }
    match /gespart_monatsreports/{document} {
      allow read: if canRead('gespart');
      allow create, update, delete: if canWrite('gespart');
    }
    match /strommastRanking/{document} {
      allow read: if canRead('spiel');
      allow create: if canWrite('spiel');
      allow update, delete: if manager('spiel');
    }
    // Mast Runner 2.0: each player maintains one personal best.
    // Only the authenticated master may delete entries to reset the list.
    function validRunnerV2Score() {
      let d = request.resource.data;
      return d.keys().hasAll(['name','score','distance','obstacles','createdAt']) &&
        d.keys().hasOnly(['name','score','distance','obstacles','createdAt']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 20 &&
        d.score is int && d.score > 0 && d.score < 100000000 &&
        d.distance is int && d.distance >= 0 && d.distance < 100000000 &&
        d.obstacles is int && d.obstacles >= 0 && d.obstacles < 1000000 &&
        d.createdAt == request.time;
    }
    match /strommastRankingV2/{playerUid} {
      allow read: if canRead('spiel');
      allow create: if canWrite('spiel') && request.auth.uid == playerUid &&
        validRunnerV2Score();
      allow update: if canWrite('spiel') && request.auth.uid == playerUid &&
        validRunnerV2Score() && request.resource.data.score > resource.data.score;
      allow delete: if master();
    }
  }
}





